{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "SiteIcons": {
    "ThirdParty": {
      "Enabled": true,
      "Providers": [ "google", "duckduckgo", "yandex" ]
    },
    "FoundTtlDays": 30,
    "MissingTtlDays": 7,
    "TransientMissingTtlHours": 24,
    "MaxIconBytes": 102400,
    "RequestTimeoutSeconds": 5,
    "TotalBudgetSeconds": 25,
    "MaxConcurrency": 8,
    "DomainAliases": {
      "iesdouyin.com": "douyin.com"
    }
  },
  "Email": {
    "Host": "smtp.163.com",
    "Port": 465,
    "FromName": "Jogeo AI",
    "Username": "",
    "Password": ""
  }
}
