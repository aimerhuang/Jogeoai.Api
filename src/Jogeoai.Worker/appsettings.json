{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AnalysisRebuild": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "SettleSeconds": 60,
    "BatchSize": 20
  },
  "Reputation": {
    "Worker": {
      "Enabled": true,
      "BatchSize": 10,
      "PollSeconds": 5,
      "TimeoutSeconds": 60,
      "MaxAttempts": 3,
      "LeaseSeconds": 180,
      "ConfidenceThreshold": 0.6,
      "AutoEnqueueSinceUtc": "2000-01-01T00:00:00Z",
      "EnqueueBatchSize": 200
    }
  }
}
