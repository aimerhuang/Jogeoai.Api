{
  "name": "ai-visibility-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "collector:app:check": "tsx apps/collector/src/app-collect.ts check",
    "collector:app:prune": "tsx apps/collector/src/app-collect.ts prune",
    "collector:app:report": "tsx apps/collector/src/app-collect.ts report",
    "collector:app:run": "tsx apps/collector/src/app-collect.ts run",
    "collector:app:serve": "tsx apps/collector/src/app-collect.ts serve",
    "collector:login": "tsx apps/collector/src/login.ts login",
    "collector:probe": "tsx apps/collector/src/login.ts probe",
    "collector:pool": "tsx apps/collector/src/pool.ts",
    "collector:run": "tsx apps/collector/src/main.ts",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf coverage",
    "compose:config": "docker compose --env-file .env.example config --quiet",
    "compose:down": "docker compose --env-file .env.example down",
    "compose:health": "node scripts/compose-health.mjs",
    "compose:up": "docker compose --env-file .env.example up -d --build",
    "db:migrate": "tsx packages/database/src/cli.ts migrate",
    "db:platforms": "tsx packages/database/src/cli.ts platforms",
    "db:profiles": "tsx packages/database/src/cli.ts profiles",
    "db:seed": "tsx packages/database/src/cli.ts seed",
    "db:schedule": "tsx packages/database/src/cli.ts schedule",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:infrastructure": "vitest run --config vitest.infrastructure.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aivc/config": "workspace:*",
    "@aivc/contracts": "workspace:*",
    "@aivc/database": "workspace:*",
    "@aivc/domain": "workspace:*",
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
