POSTGRES_DB=ai_visibility
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-development-only
POSTGRES_APP_USER=ai_visibility
POSTGRES_APP_PASSWORD=local-development-only
DATABASE_URL=postgres://ai_visibility:local-development-only@localhost:55432/ai_visibility
API_PORT=4311
COLLECTOR_API_URL=http://localhost:4311
COLLECTOR_CN_SERVICE_TOKEN=local-cn-token-change-before-sharing
COLLECTOR_OVERSEAS_SERVICE_TOKEN=local-overseas-token-change-before-sharing
COLLECTOR_SPOOL_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COLLECTOR_CN_EGRESS_COUNTRY=CN
COLLECTOR_OVERSEAS_EGRESS_COUNTRY=JP
COLLECTOR_OVERSEAS_PROXY_URL=

# Compose remains Mock-only. Native real setup: docs/runbooks/real-doubao-smoke.md
COLLECTOR_MODE=mock
# Real mode requires the following in an ignored/external environment file:
# COLLECTOR_API_URL=http://127.0.0.1:4314
# COLLECTOR_SERVICE_TOKEN=<CN token of dedicated smoke API>
# COLLECTOR_TENANT_ID=<smoke tenant UUID>
# COLLECTOR_EXPECTED_PROJECT_ID=<isolated approved project UUID>
# COLLECTOR_NODE_ID=doubao-cn-real-smoke
# COLLECTOR_REGION=cn
# COLLECTOR_EGRESS_COUNTRY=CN
# COLLECTOR_SUPPORTED_PLATFORMS=doubao
# COLLECTOR_CAPACITY=1
# COLLECTOR_LEASE_SECONDS=300
# COLLECTOR_HEARTBEAT_INTERVAL_MS=60000
# COLLECTOR_HTTP_TIMEOUT_MS=10000
# COLLECTOR_COLLECTION_TIMEOUT_MS=180000
# COLLECTOR_MIN_REQUEST_INTERVAL_MS=15000
# Task cap 1-10 (default 4); the attempt ledger counts it per API/tenant/project binding.
# Ignored with COLLECTOR_SESSION_PROFILE_ID: profile-mode collectors are resident, the control
# plane's quotas govern throughput and the ledger only dedupes each task lease version.
# COLLECTOR_MAX_TASKS_PER_RUN=4
# Optional operator-approved exact question list (0600 regular file owned by this user,
# JSON {version:1, tenantId, projectId, approvedAt, questions[1..50]}); unset = built-in list.
# COLLECTOR_APPROVED_QUESTIONS_FILE=/absolute/path/aivc/real-smoke/approved-questions.json
# Account pool and challenge wait: docs/runbooks/account-pool.md.
# Optional. Needed only with this repository's account pool (profile registered via
# `pnpm db:profiles add`); the pool supervisor sets it per entry. Unset: no profile is sent on
# lease and no failure/session events are reported, so single-account runs against control
# planes without an account pool keep working; the challenge wait and notifications still apply.
# Set: real mode runs resident (eligibility check -> probe -> lease -> collect, repeated until
# shutdown), sleeping the control plane's retryAfterSeconds (30-120 s) while not eligible.
# COLLECTOR_SESSION_PROFILE_ID=<registered session profile UUID>
# Total wait per task for a human to clear a visible challenge (default 600000, max 1800000,
# 0 = fail immediately). Heartbeats continue and the collection deadline is extended.
# COLLECTOR_CHALLENGE_WAIT_MS=600000
# Optional absolute executable (no shell, allowlisted env) receiving the operator notice JSON on
# stdin; notices carry identifiers only, never question text or page content.
# COLLECTOR_NOTIFY_COMMAND=/absolute/path/aivc/bin/notify-operator
# Pool supervisor (`pnpm collector:pool`): absolute JSON file with one entry per account
# ({sessionProfileId, platform, profileDirectory, spoolDirectory, cdpUrl?, label?}).
# COLLECTOR_POOL_FILE=/absolute/path/aivc/pool/pool-doubao.json
# Restart delay after a child finished with exit 0 (default 60000, 1000-3600000). Resident
# children only exit 0 on shutdown, so this is a fallback.
# COLLECTOR_POOL_IDLE_MS=60000
# Delay between starting consecutive pool entries (default 15000, 0-600000).
# COLLECTOR_POOL_STAGGER_MS=15000
# COLLECTOR_RUN_ONCE=false
# COLLECTOR_BUILD_REVISION=<reviewed git revision>-real-doubao
# COLLECTOR_PROFILE_DIRECTORY=/absolute/path/aivc/real-smoke/doubao-cn
# COLLECTOR_SPOOL_DIRECTORY=/absolute/path/aivc/real-smoke/spool-doubao-cn
# COLLECTOR_SPOOL_KEY=<unique random 32-byte base64 key, not the mock example key>
# COLLECTOR_BROWSER_HEADLESS=false
# DOUBAO_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/doubao-page-contract.json
# Ernie follow-up: docs/runbooks/real-ernie-smoke.md. Select exactly one platform.
# COLLECTOR_SUPPORTED_PLATFORMS=ernie
# ERNIE_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/ernie-page-contract.json
# Qingyan follow-up: docs/runbooks/real-qingyan-smoke.md. Use a dedicated profile/spool.
# COLLECTOR_SUPPORTED_PLATFORMS=zhipu_qingyan
# QINGYAN_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/qingyan-page-contract.json
# COLLECTOR_SUPPORTED_PLATFORMS=qwen
# QWEN_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/qwen-page-contract.json
# COLLECTOR_SUPPORTED_PLATFORMS=kimi
# KIMI_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/kimi-page-contract.json
# DeepSeek consumer-Web follow-up: docs/runbooks/real-deepseek-smoke.md.
# COLLECTOR_SUPPORTED_PLATFORMS=deepseek
# DEEPSEEK_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/deepseek-page-contract.json
# Tencent Yuanbao consumer-Web follow-up: docs/runbooks/real-yuanbao-smoke.md.
# COLLECTOR_SUPPORTED_PLATFORMS=tencent_yuanbao
# YUANBAO_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/yuanbao-page-contract.json
# ChatGPT consumer-Web follow-up: docs/runbooks/real-chatgpt-smoke.md.
# Use an overseas egress and a dedicated persistent profile; never commit the contract.
# COLLECTOR_REGION=overseas
# COLLECTOR_EGRESS_COUNTRY=JP
# COLLECTOR_SUPPORTED_PLATFORMS=chatgpt
# CHATGPT_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/chatgpt-page-contract.json
# Gemini consumer-Web follow-up: docs/runbooks/real-gemini-smoke.md.
# COLLECTOR_PROFILE_DIRECTORY=/absolute/path/aivc/real-smoke/gemini-overseas
# COLLECTOR_REGION=overseas
# COLLECTOR_EGRESS_COUNTRY=<ISO-3166-1-alpha-2-country>
# COLLECTOR_SUPPORTED_PLATFORMS=gemini
# GEMINI_PAGE_CONTRACT_PATH=/absolute/path/aivc/real-smoke/gemini-page-contract.json
# Optional safer alternative to Collector-launched Chromium: connect to a
# user-managed local Chrome started with --remote-debugging-port=9222.
# COLLECTOR_BROWSER_CDP_URL=http://127.0.0.1:9222
# Use separate Ernie profile, spool and node settings; retain prior Doubao evidence.
