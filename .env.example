ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
MYSQL_DATABASE=jogeoai
MYSQL_USER=jogeoai_app
MYSQL_PASSWORD=jogeoai_dev_password
MYSQL_ROOT_PASSWORD=jogeoai_root_password
MYSQL_PORT=3306
# Keep this connection string in sync with MYSQL_* above. Quotes are required for shell loading.
ConnectionStrings__Default='Server=127.0.0.1;Port=3306;Database=jogeoai;User ID=jogeoai_app;Password=jogeoai_dev_password;Connection Timeout=5;Default Command Timeout=5;'
# Internal Node.js Collector token; keep this in User Secrets or another secret store outside source control.
Collector__ChinaServiceToken='replace-with-a-local-cn-collector-token'
# Optional comma-separated tenant allowlist for the CN Collector (set in production).
Collector__ChinaTenantIds=''
# Optional tenant allowlist for the App channel (migration 049). Empty keeps the App channel closed to every tenant;
# the API and the Worker must use the same value.
Collector__AppTenantIds=''
# Knowledge files use a local private object directory in development. Keep it outside source control.
Knowledge__Storage__Provider=local
Knowledge__StorageRoot='.data/knowledge'
# To use MinIO/S3 instead, set Provider=s3 and provide these values through a secret store:
# Knowledge__Storage__Endpoint='http://localhost:9000'
# Knowledge__Storage__Bucket='jogeoai-knowledge'
# Knowledge__Storage__AccessKey='replace-with-storage-access-key'
# Knowledge__Storage__SecretKey='replace-with-storage-secret-key'
# Knowledge__Storage__Region='us-east-1'
# Knowledge__Storage__ForcePathStyle=true
# The deterministic/local implementations keep local development independent of external services.
Knowledge__Embedding__Provider=deterministic
Knowledge__Vector__Provider=local
Knowledge__VectorRoot='.data/knowledge-vectors'
# For external indexing, set Embedding__Provider=openai-compatible and Vector__Provider=qdrant;
# keep the following credentials and model settings in User Secrets or a production secret store.
# Knowledge__Embedding__Url='http://localhost:8080/v1/embeddings'
# Knowledge__Embedding__Model='text-embedding-3-small'
# Knowledge__Embedding__Dimensions=1536
# Knowledge__Embedding__ApiKey='replace-with-embedding-api-key'
# Knowledge__Qdrant__Url='http://localhost:6333'
# Qdrant collection profile and dimensions follow the active Embedding provider.
# Cloro and research Provider credentials are stored in MySQL through their APIs.
# The research Provider model and URL default to openai-compatible / gpt-6-luna /
# https://api.openai.com/v1/chat/completions; supply the real credential through
# the system-admin Provider endpoint before enabling the row.

# 163 SMTP: implicit TLS on 465. Use the SMTP authorization code, not the login password.
Email__Host=smtp.163.com
Email__Port=465
Email__Username=''
Email__Password=''
Email__FromName='Jogeo AI'
