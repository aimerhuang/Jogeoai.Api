# Copy to deploy/.env (never commit it) and set file mode 600:
#   cp deploy/.env.production.example deploy/.env && chmod 600 deploy/.env
# Every value below is a placeholder. Generate real secrets on the server.

# Image naming; change JOGEOAI_TAG to roll forward or back.
JOGEOAI_IMAGE_PREFIX=jogeoai
JOGEOAI_TAG=latest

# Host loopback port the API is published on (the TLS gateway proxies to it).
API_PORT=5260

# Trusted forwarded headers (X-Forwarded-For / X-Forwarded-Proto), API only. See docx/deployment.md 2.2 and 2.4.
# Subnet of this compose project's network. The API trusts it as the hop next to it (the host gateway reaches
# the container through the published port and shows up with an address from this subnet).
# Change it only if it collides with an existing network on the host.
JOGEOAI_SUBNET=172.30.250.0/24
# Egress IP of the frontend server that proxies /api/ to the backend gateway (a single IP, not a CIDR).
# Empty = only the host gateway hop is trusted; the API then sees the frontend server's IP for browser traffic.
FRONTEND_PROXY_IP=
# How many X-Forwarded-For entries the API may take, counted from the right (1-5).
# 2 = frontend server + host gateway. The API refuses to start when the value is outside 1-5.
FORWARDED_LIMIT=2

# MySQL (used to create the database on first start and by the API/Worker connection string).
MYSQL_DATABASE=jogeoai
MYSQL_USER=jogeoai_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Web (Playwright) collector service token for /internal/collector/*. Leave empty to disable.
COLLECTOR_CHINA_SERVICE_TOKEN=
# Tenant (GUID) allowed for the web collector. Add more in compose as Collector__ChinaTenantIds__1, ...
COLLECTOR_CHINA_TENANT_ID_0=
# Tenant (GUID) for which the App channel is open. Empty keeps the App channel closed.
# API and Worker get the same value from compose.
COLLECTOR_APP_TENANT_ID_0=
# Further App tenants, comma-separated GUIDs (e.g. "<guid-1>,<guid-2>"). Empty adds none.
COLLECTOR_APP_TENANT_IDS=

# Outgoing mail (registration verification codes). Use the SMTP authorization code, not the login password.
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Jogeo AI
