# Jogeoai Worker image. Build context: repository root.
#   docker build -f deploy/Dockerfile.worker -t jogeoai-worker .
# The Worker uses the ASP.NET Core runtime because Jogeoai.Infrastructure references Microsoft.AspNetCore.App.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Jogeoai.Worker/Jogeoai.Worker.csproj -c Release -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /out ./
RUN mkdir -p /app/data/knowledge /app/data/knowledge-vectors && chown -R $APP_UID /app/data
ENV DOTNET_ENVIRONMENT=Production \
    Knowledge__StorageRoot=/app/data/knowledge \
    Knowledge__VectorRoot=/app/data/knowledge-vectors
USER $APP_UID
# Extra arguments (for example --MonitoringOnly=true) can be appended with the compose "command" key.
ENTRYPOINT ["dotnet", "Jogeoai.Worker.dll"]
